---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---
<div class="mb-10 max-w-3xl">
  <p class="eyebrow mb-4">{eyebrow}</p>
  <h1 class="section-title text-paper">{title}</h1>
  {intro && <p class="mt-6 max-w-2xl text-lg leading-7 text-muted">{intro}</p>}
</div>
