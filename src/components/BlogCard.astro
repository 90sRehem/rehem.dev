---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  readingTime: string;
  slug: string;
}
const { title, description, pubDate, readingTime, slug } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
---
<article class="border-t-2 border-paper/25 py-7 first:border-t-0">
  <div class="grid gap-4 sm:grid-cols-[150px_1fr_auto] sm:items-start sm:gap-8">
    <p class="font-mono text-xs uppercase tracking-wider text-muted">{formattedDate}</p>
    <div>
      <h2 class="text-2xl font-black tracking-[-0.05em] text-paper"><a class="hover:text-teal" href={`/blog/${slug}/`}>{title}</a></h2>
      <p class="mt-2 max-w-xl leading-6 text-muted">{description}</p>
    </div>
    <p class="font-mono text-xs uppercase tracking-wider text-yellow sm:text-right">{readingTime}</p>
  </div>
</article>
