---
interface Props {
  category: string;
  items: string[];
  index: number;
}
const { category, items, index } = Astro.props;
const accent = index % 2 === 0 ? 'text-teal' : 'text-yellow';
---
<div class="stack-group border-2 border-paper/30 bg-panel p-5" style={`transition-delay: ${index * 60}ms`}>
  <p class={`font-mono text-xs uppercase tracking-widest ${accent}`}>{category}</p>
  <div class="mt-5 flex flex-wrap gap-2">
    {items.map((item) => (
      <span class="border border-paper/30 bg-ink px-3 py-1.5 font-mono text-xs uppercase tracking-wide text-paper/80">{item}</span>
    ))}
  </div>
</div>
