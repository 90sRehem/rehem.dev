---
import { profile } from '../data/profile';
---
<footer class="mt-24 border-t-2 border-paper/20">
  <div class="site-shell flex flex-col gap-5 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p class="font-mono text-xs">© {new Date().getFullYear()} rehem.dev</p>
    <div class="flex gap-5 font-mono text-xs uppercase tracking-wider">
      <a class="hover:text-teal" href={profile.social.github} target="_blank" rel="noreferrer">GitHub ↗</a>
      <a class="hover:text-teal" href={profile.social.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
      <a class="hover:text-teal" href={profile.social.x} target="_blank" rel="noreferrer">X ↗</a>
    </div>
  </div>
</footer>
