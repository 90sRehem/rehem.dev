---
import type { Project } from '../data/projects';

type Props = Project;
const { title, description, tags, href, kind } = Astro.props;
const isContribution = kind === 'contribuição';
---
<article class:list={['group flex h-full flex-col bg-panel p-5 sm:p-6', isContribution ? 'brutal-card-yellow' : 'brutal-card']}>
  <p class:list={['eyebrow mb-3 text-xs', isContribution ? 'text-yellow' : 'text-teal']}>{kind}</p>
  <h3 class="font-mono text-xl font-bold tracking-[-0.02em] text-paper">{title}</h3>
  <p class="mt-3 flex-1 leading-6 text-muted">{description}</p>
  <div class="mt-6 flex flex-wrap gap-2">
    {tags.map((tag) => <span class="border border-paper/30 px-2 py-1 font-mono text-[0.65rem] uppercase tracking-wide text-paper/70">{tag}</span>)}
  </div>
  <a href={href} target="_blank" rel="noreferrer" class="mt-6 self-start font-mono text-xs font-bold uppercase tracking-wider text-teal underline decoration-2 underline-offset-4 hover:text-paper">Ver no GitHub ↗</a>
</article>
