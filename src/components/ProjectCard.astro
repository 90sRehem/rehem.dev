---
interface Props {
  title: string;
  type: string;
  description: string;
  image: string;
  tags: string[];
  href?: string;
  featured?: boolean;
}
const { title, type, description, image, tags, href = '#', featured = false } = Astro.props;
---
<article class:list={["group flex h-full flex-col bg-panel p-4 sm:p-5", featured ? 'brutal-card' : 'brutal-border']}>
  <a href={href} class="block overflow-hidden border-2 border-paper/30" aria-label={`Ver projeto ${title}`}>
    <img src={image} alt={`Arte visual do projeto ${title}`} width="800" height="500" loading="lazy" class="aspect-[16/10] w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" />
  </a>
  <div class="flex flex-1 flex-col pt-5">
    <p class="eyebrow mb-3 text-xs text-yellow">{type}</p>
    <h2 class="text-2xl font-black tracking-[-0.06em] text-paper sm:text-3xl">{title}</h2>
    <p class="mt-3 flex-1 leading-6 text-muted">{description}</p>
    <div class="mt-6 flex flex-wrap gap-2">
      {tags.map((tag) => <span class="border border-paper/30 px-2 py-1 font-mono text-[0.65rem] uppercase tracking-wide text-paper/70">{tag}</span>)}
    </div>
    <a href={href} class="mt-6 self-start font-mono text-xs font-bold uppercase tracking-wider text-teal underline decoration-2 underline-offset-4 hover:text-paper">Abrir case ↗</a>
  </div>
</article>
