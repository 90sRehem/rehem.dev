---
import { profile } from '../data/profile';

const links = [
  { href: '/#projetos', label: 'Projetos' },
  { href: '/#stack', label: 'Stack' },
  { href: '/#sobre', label: 'Sobre' },
  { href: '/#contato', label: 'Contato' },
];
---

<header class="border-b-2 border-paper/20">
  <div class="site-shell flex min-h-20 flex-wrap items-center justify-between gap-4 py-4">
    <a href="/" class="font-mono text-lg font-bold tracking-[-0.08em]" aria-label="rehem.dev, início">
      <span class="text-teal">rehem</span><span class="text-paper">.dev</span>
    </a>
    <nav aria-label="Navegação principal">
      <ul class="flex flex-wrap items-center justify-end gap-x-4 gap-y-2 font-mono text-[0.7rem] font-bold uppercase tracking-[0.06em] text-muted sm:gap-x-6">
        {links.map((link) => (
          <li>
            <a href={link.href} class="transition-colors hover:text-teal">{link.label}</a>
          </li>
        ))}
        <li>
          <a href={profile.social.github} target="_blank" rel="noreferrer" class="transition-colors hover:text-teal">GitHub ↗</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
