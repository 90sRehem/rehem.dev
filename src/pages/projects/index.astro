---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { projects } from '../../data/projects';
---

<Layout title="Projetos — Rehem" description="Uma seleção de produtos, interfaces e sistemas visuais feitos por Rehem.">
  <section class="site-shell py-20 sm:py-28">
    <SectionHeading eyebrow="arquivo / 2022—2025" title="Projetos que encontram seu lugar no mundo." intro="Cada trabalho começa com uma pergunta. O resultado pode ser uma interface, um sistema, uma identidade — mas precisa fazer sentido quando chega na mão de alguém." />
    <div class="grid gap-8 md:grid-cols-2">
      {projects.map((project) => <ProjectCard {...project} />)}
    </div>
  </section>
</Layout>
