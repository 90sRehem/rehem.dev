---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Mensagem enviada — Rehem" description="Sua mensagem foi enviada com sucesso." noindex>
  <section class="site-shell flex min-h-[60vh] flex-col justify-center py-20 sm:py-28">
    <p class="eyebrow mb-5">contato / enviado</p>
    <h1 class="display-title max-w-3xl text-paper">Valeu por <span class="text-teal">escrever.</span></h1>
    <p class="mt-6 max-w-xl text-lg leading-8 text-muted">Recebi sua mensagem e vou responder em até dois dias úteis.</p>
    <a class="brutal-button mt-10 self-start" href="/">Voltar para o início <span aria-hidden="true">↗</span></a>
  </section>
</Layout>
