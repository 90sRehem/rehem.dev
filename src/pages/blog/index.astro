---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog — Rehem" description="Notas de Rehem sobre tecnologia, processo e o trabalho de fazer software.">
  <section class="site-shell py-20 sm:py-28">
    <p class="eyebrow mb-4">notas / sem periodicidade</p>
    <h1 class="section-title text-paper">Pensamentos em<br /><span class="text-teal">estado de rascunho.</span></h1>
    <div class="brutal-card-yellow mt-10 bg-panel p-5 sm:p-7" role="status">
      <p class="font-mono text-xs font-bold uppercase tracking-wider text-yellow">WIP</p>
      <p class="mt-3 max-w-2xl text-lg leading-7 text-muted">O blog está sendo retomado. Novas notas aparecerão aqui quando estiverem prontas.</p>
    </div>
    {posts.length > 0 && <div class="mt-12 max-w-4xl border-b-2 border-paper/25">{posts.map((post) => <BlogCard {...post.data} slug={post.id} />)}</div>}
  </section>
</Layout>
