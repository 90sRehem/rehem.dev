---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog — Rehem" description="Notas de Rehem sobre design, tecnologia, processo e o trabalho de fazer coisas com cuidado.">
  <section class="site-shell py-20 sm:py-28">
    <SectionHeading eyebrow="notas / sem periodicidade" title="Pensamentos em estado de rascunho." intro="Um lugar para organizar perguntas, registrar aprendizados e compartilhar o que estou descobrindo enquanto faço." />
    <div class="max-w-4xl border-b-2 border-paper/25">
      {posts.map((post) => <BlogCard {...post.data} slug={post.id} />)}
    </div>
  </section>
</Layout>
